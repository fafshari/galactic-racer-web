{
  "name": "galactic-racer-web",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Galactic Racer build planner and tour simulator (Astro + Svelte)",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "import-data": "node scripts/import-data.ts",
    "og-image": "node scripts/og-image.ts",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "astro": "^7.4.4",
    "svelte": "^5.57.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
