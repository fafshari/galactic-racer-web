---
// Temporary: stands in for a page until its port lands. Delete with the last placeholder.
interface Props {
  what: string;
  legacyHref: string;
}

const { what, legacyHref } = Astro.props;
---

<section class="placeholder-panel">
  <h2 class="heading">Being rebuilt</h2>
  <p class="text">The {what} is moving to a new home. Until it's ready, use the <a href={legacyHref}>current {what}</a>.</p>
</section>

<style lang="scss">
  .placeholder-panel {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .placeholder-panel > .heading {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .placeholder-panel > .text {
    margin: 0;
  }
</style>
