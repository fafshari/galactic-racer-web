---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TourSimulator from '~/components/TourSimulator/TourSimulator.svelte';
import TourNotes from '~/components/TourNotes/TourNotes.astro';
import { manifest } from '~/lib/data/index.ts';
---

<BaseLayout
  title="Galactic Racer Tour Simulator"
  eyebrow={`Multiplayer Tour run · game build ${manifest.gameBuild}`}
  description="Simulate a STAR WARS: Galactic Racer Multiplayer Tour run with the game's real shop, reward and reroll odds."
>
  <TourSimulator client:load />
  <TourNotes />
</BaseLayout>
