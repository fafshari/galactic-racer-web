---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TourSimulator from '~/components/TourSimulator/TourSimulator.svelte';
import TourNotes from '~/components/TourNotes/TourNotes.astro';
---

<BaseLayout
  title="Galactic Racer Tour Simulator"
  description="Play through a STAR WARS: Galactic Racer Multiplayer Tour run."
>
  <p class="early-notice"><b>Early development.</b> The tour simulator still needs more testing, so a run may not match the game yet.</p>
  <TourSimulator client:load />
  <TourNotes />
</BaseLayout>

<style lang="scss">
  // A heads-up above the simulator, in the readout's mustard accent.
  .early-notice {
    margin: 0 0 var(--space-4);
    padding: 10px 14px;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-mustard);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    color: var(--color-muted);
    font-size: 14px;

    b {
      color: var(--color-fg);
    }
  }
</style>
