---
// Component showcase (ADR 0006). Injected only under `astro dev`; never part of a production build.
import BaseLayout from '~/layouts/BaseLayout.astro';
import Tag from '~/components/Tag/Tag.svelte';
import StatPips from '~/components/StatPips/StatPips.svelte';
import StatPipsDemo from '~/components/StatPips/StatPipsDemo.svelte';

const themes = ['light', 'dark'] as const;
---

<BaseLayout title="Components" eyebrow="Development only" description="Component showcase." noindex>
  <div class="showcase-grid">
    {
      themes.map((theme) => (
        <section class="theme-column" data-theme={theme}>
          <h2 class="heading">{theme}</h2>

          <article class="specimen">
            <h3 class="name">Tag</h3>
            <div class="row">
              <Tag>Common</Tag>
              <Tag variant="cond">Situational</Tag>
              <Tag variant="good">Best fit</Tag>
              <Tag variant="neg">Faulty</Tag>
            </div>
          </article>

          <article class="specimen">
            <h3 class="name">StatPips</h3>
            <StatPipsDemo client:load />
            <div class="pip-strip">
              <StatPips level={3} label="Boost" />
            </div>
          </article>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style lang="scss">
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .theme-column {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .theme-column > .heading {
    font-size: 12.5px;
    font-weight: 800;
  }

  .specimen {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .specimen > .name {
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 800;
  }

  .specimen > .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .specimen > .pip-strip {
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--color-teal);
  }
</style>
