---
import { Font } from 'astro:assets';
import SiteHeader from '~/components/SiteHeader/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter/SiteFooter.astro';
import { THEME_KEY } from '~/lib/theme.ts';
import '~/styles/global.scss';

interface Props {
  title: string;
  description: string;
  /** Short line above the page title, e.g. the game mode. */
  eyebrow?: string;
  /** Keep the page out of search results (the dev-only showcase). */
  noindex?: boolean;
}

const { title, description, eyebrow, noindex = false } = Astro.props;
// Link previews (Discord, Slack, ...) need absolute URLs; `site` is set in astro.config.ts.
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname.replace(/index\.html$/, ''), site).href;
const image = new URL('/og.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#b84a31" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Galactic Racer Planner" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Galactic Racer build planner and tour simulator." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ key: THEME_KEY }}>
      // Apply a saved theme before first paint, so a picked theme never flashes the device's one first.
      try {
        const t = localStorage.getItem(key);
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-barlow" />
    <Font cssVariable="--font-barlow-semi" />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader title={title} {...(eyebrow === undefined ? {} : { eyebrow })} />
      <main class="content">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style lang="scss">
  .page-shell {
    display: grid;
    gap: var(--space-5);
    max-width: 1280px;
    margin: 0 auto;
    padding-block: var(--space-5) 64px;
    padding-inline: max(var(--space-4), env(safe-area-inset-left, 0px)) max(var(--space-4), env(safe-area-inset-right, 0px));
  }

  .page-shell > .content {
    min-width: 0;
  }
</style>
